# /etc/nginx/sites-available/qr.yaksok.kr
#
# 적용 순서:
#   1) 아래 파일 내용 그대로 저장 후:
#        sudo ln -s /etc/nginx/sites-available/qr.yaksok.kr /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#   2) SSL 발급 (아래 80번 포트 블록을 certbot이 자동으로 443 블록 + https 리다이렉트로 확장합니다):
#        sudo certbot --nginx -d qr.yaksok.kr
#
# 아래는 certbot 실행 "이전" 상태입니다. certbot 실행 후 이 파일이 자동으로 수정되니
# 직접 443 블록을 추가로 작성할 필요는 없습니다.

server {
    listen 80;
    listen [::]:80;
    server_name qr.yaksok.kr;

    # Let's Encrypt 인증서 발급/갱신용 ACME 챌린지. `=` 정확 매칭 위치들보다 먼저 선언해도
    # 상관없지만, 다른 prefix location에 절대 가로채이지 않도록 `^~`로 우선순위를 명시한다.
    # certbot --nginx 플러그인을 쓰면 보통 이 블록 없이도 자동으로 처리되지만, webroot 방식으로
    # 전환하거나 수동 갱신 시를 대비해 명시적으로 남겨둔다.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Android App Links / iOS Universal Links 검증 파일은 반드시
    # 리다이렉트 없이 앱 서버가 직접 응답해야 한다. `=`(정확 매칭)로 선언해서
    # 다른 어떤 prefix location보다도 우선 적용되도록 한다.
    location = /.well-known/assetlinks.json {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }
    location = /.well-known/apple-app-site-association {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 1m;
}
