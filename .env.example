# MySQL은 앱 서버와 같은 머신에 설치, 127.0.0.1:3306 으로만 접속합니다.
DB_HOST=127.0.0.1
DB_PORT=3306
# 애플리케이션 전용 계정입니다. root를 여기에 넣지 마세요.
# schema.sql 실행 시 만든 계정/비밀번호와 동일하게 맞춰주세요.
DB_USER=yaksok_app
DB_PASSWORD=change_me_strong_password
DB_NAME=yaksok_qr

PORT=3000
# 프로토콜 포함, 끝에 슬래시 없이. QR URL 생성에 사용됩니다.
BASE_URL=https://qr.yaksok.kr

# 처방전 등록/폐기(POST, DELETE /api/prescriptions) 호출 시 X-API-Key 헤더로 검증되는 값입니다.
# 비어 있으면 서버가 부팅 시 즉시 에러를 던지고 종료합니다 (무인증 배포 방지).
# 강력한 랜덤 값으로 채우세요: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change_me_random_admin_api_key

NODE_ENV=production
