# AWS RDS for MySQL 인스턴스 엔드포인트. RDS 콘솔 > 데이터베이스 > 연결 & 보안 탭에서 확인.
DB_HOST=your-instance.xxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
# 애플리케이션 전용 계정입니다. RDS 마스터(admin) 계정을 여기에 넣지 마세요.
# schema.sql을 admin 계정으로 실행해 생성한 yaksok_app 계정/비밀번호와 동일하게 맞춰주세요.
DB_USER=yaksok_app
DB_PASSWORD=change_me_strong_password
DB_NAME=yaksok
# RDS는 네트워크를 경유하므로 SSL 필수. certs/에 리전 CA 번들이 있어야 합니다 (README 참고).
DB_SSL=true

PORT=3000
# 프로토콜 포함, 끝에 슬래시 없이. QR URL 생성에 사용됩니다.
BASE_URL=https://yaksok-qr.onrender.com

# 처방전 등록/폐기(POST, DELETE /api/prescriptions) 호출 시 X-API-Key 헤더로 검증되는 값입니다.
# 비어 있으면 서버가 부팅 시 즉시 에러를 던지고 종료합니다 (무인증 배포 방지).
# 강력한 랜덤 값으로 채우세요: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change_me_random_admin_api_key

NODE_ENV=production
